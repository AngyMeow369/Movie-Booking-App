@model Movie_Booking_App.Models.Movie
@{
    ViewData["Title"] = Model.Title;
    Layout = "_UserLayout";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4 text-center mb-4">
            <img src="@Model.PosterUrl" alt="@Model.Title" class="img-fluid rounded shadow" style="max-height: 450px;" />
        </div>
        <div class="col-md-8 text-start">
            <h1 class="display-4 fw-bold">@Model.Title</h1>
            <p class="lead text-muted"><span class="badge bg-primary">@Model.Genre</span> | <span>@Model.Language</span></p>
            <hr />
            
            <div class="mb-4">
                <h5>Synopsis</h5>
                <p>@Model.Description</p>
            </div>

            <div class="row mb-4">
                <div class="col-6 col-md-3">
                    <strong>Duration:</strong>
                    <p>@Model.Duration mins</p>
                </div>
                <div class="col-6 col-md-3">
                    <strong>Release Date:</strong>
                    <p>@Model.ReleaseDate.ToString("MMM dd, yyyy")</p>
                </div>
            </div>

            <div class="d-grid d-md-flex gap-2">
                <a asp-area="User" asp-controller="Bookings" asp-action="Book" asp-route-id="@Model.Id" class="btn btn-primary btn-lg px-5">
                    <i class="fas fa-ticket-alt me-2"></i>Book Tickets
                </a>
                <a asp-area="User" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>
