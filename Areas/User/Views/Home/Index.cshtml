@{
    ViewData["Title"] = "User Dashboard";
    Layout = "_UserLayout";
    var bookings = ViewBag.Bookings as IEnumerable<Movie_Booking_App.Models.Booking> ?? Enumerable.Empty<Movie_Booking_App.Models.Booking>();
    var availableMovies = ViewBag.AvailableMovies as IEnumerable<Movie_Booking_App.Models.Movie> ?? Enumerable.Empty<Movie_Booking_App.Models.Movie>();
}

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4">
    <div class="container-fluid">
        <h4 class="navbar-brand text-primary mb-0">🎬 User Dashboard</h4>
        <div class="d-flex align-items-center">
            <span class="fw-semibold text-dark">Welcome, @ViewBag.FullName!</span>
        </div>
    </div>
</nav>

<div class="container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- My Bookings CTA -->
    <div class="section-title text-center mb-4">
        <h3 class="styled-heading">
            🎟️ My Bookings ✨
        </h3>
        <div class="title-underline mx-auto"></div>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-md-5 col-sm-8">
            <a asp-area="User" asp-controller="Bookings" asp-action="MyBookings" class="text-decoration-none">
                <div class="card shadow-sm hover-card bookings-card text-white text-center p-3">
                    <h5 class="card-title mb-2"><i class="bi bi-clipboard2-check-fill me-2"></i> View Bookings</h5>
                    <p class="card-text mb-0">View and manage your movie bookings.</p>
                </div>
            </a>
        </div>
    </div>

    <!-- Now Playing Section -->
    <div class="section-title text-center mb-4">
        <h3 class="styled-heading">
            🍿 Now Playing 🎥
        </h3>
        <div class="title-underline mx-auto"></div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (availableMovies.Any())
                    {
                        <div class="row g-3">
                            @foreach (var movie in availableMovies)
                            {
                                <div class="col-md-3 col-sm-6">
                                    <a asp-area="User" asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" class="text-decoration-none text-dark">
                                        <div class="card h-100 movie-card shadow-sm">
                                            <div class="poster-container">
                                                <img src="@movie.PosterUrl" class="card-img-top poster-img" alt="@movie.Title">
                                            </div>
                                            <div class="card-body d-flex flex-column text-start">
                                                <h5 class="card-title movie-title">@movie.Title</h5>
                                                <p class="card-text movie-details mb-1"><strong>Genre:</strong> @movie.Genre</p>
                                                @{
                                                    int hours = movie.Duration / 60;
                                                    int minutes = movie.Duration % 60;
                                                }
                                                <p class="card-text movie-details mb-2"><strong>Length:</strong> @hours h @minutes m</p>
                                                <a asp-area="User" asp-controller="Bookings" asp-action="Book" asp-route-id="@movie.Id" class="btn btn-primary mt-auto">Book Now</a>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No movies available for booking at the moment.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Section titles */
    .section-title {
        position: relative;
    }

    .styled-heading {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0d6efd;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .title-underline {
        width: 80px;
        height: 4px;
        background: linear-gradient(90deg, #ffc107, #0d6efd);
        border-radius: 2px;
        margin-top: 0.5rem;
    }

    /* Poster Hover */
    .poster-container {
        overflow: hidden;
        border-radius: 0.25rem 0.25rem 0 0;
    }

    .poster-img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .poster-container:hover .poster-img {
        transform: scale(1.05);
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }

    /* Movie card hover */
    .movie-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border-radius: 0.5rem;
    }

    .movie-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    /* Movie title & details */
    .movie-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.3rem;
        color: #FFD700;
    }

    .movie-details {
        font-size: 0.9rem;
        color: #555;
    }

    /* My Bookings Card */
    .bookings-card {
        background: linear-gradient(135deg, #1f3b70, #3a64b2);
        border-radius: 0.75rem;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .bookings-card:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 10px 25px rgba(0,0,0,0.25);
    }

    .hover-card {
        cursor: pointer;
    }
</style>
