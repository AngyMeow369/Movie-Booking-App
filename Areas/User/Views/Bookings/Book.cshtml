@{
    var movie = ViewBag.Movie as Movie_Booking_App.Models.Movie;
    var groupedShowTimes = ViewBag.GroupedShowTimes as Dictionary<Movie_Booking_App.Models.Theater, List<Movie_Booking_App.Models.ShowTime>> 
                           ?? new Dictionary<Movie_Booking_App.Models.Theater, List<Movie_Booking_App.Models.ShowTime>>();
    ViewData["Title"] = $"Book - {movie?.Title}";
    Layout = "_UserLayout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="card shadow border-0 text-start">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold">🎟️ Book Tickets for @movie?.Title</h4>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <img src="@movie?.PosterUrl" alt="@movie?.Title" class="rounded me-3 shadow-sm" style="width: 100px; height: 150px; object-fit: cover;" />
                        <div>
                            <h5 class="fw-bold mb-1">@movie?.Title</h5>
                            <p class="text-muted mb-1"><strong>Genre:</strong> @movie?.Genre</p>
                            <p class="text-muted mb-0"><strong>Duration:</strong> @movie?.Duration mins</p>
                        </div>
                    </div>

                    <form asp-area="User" asp-controller="Bookings" asp-action="Book" method="post">
                        <input type="hidden" name="movieId" value="@ViewBag.MovieId" />

                        @if (groupedShowTimes.Any())
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold mb-3">Select Theater and Showtime</label>
                                
                                @foreach (var theaterGroup in groupedShowTimes)
                                {
                                    <div class="card mb-3 border bg-light">
                                        <div class="card-body p-3">
                                            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-map-marker-alt me-2 text-danger"></i>@theaterGroup.Key.Name <span class="text-muted">(@theaterGroup.Key.City)</span></h6>
                                            <div class="row g-2">
                                                @foreach (var showtime in theaterGroup.Value)
                                                {
                                                    <div class="col-md-6 col-lg-4">
                                                        <input type="radio" class="btn-check" name="selectedShowTimeId" id="showtime_@showtime.Id" value="@showtime.Id" required />
                                                        <label class="btn btn-outline-primary w-100 text-start p-2 d-flex flex-column h-100" for="showtime_@showtime.Id">
                                                            <span class="fw-bold">@showtime.ShowDateTime.ToString("t")</span>
                                                            <span class="text-muted small">@showtime.ShowDateTime.ToString("MMM dd, yyyy")</span>
                                                            <span class="badge bg-secondary align-self-start mt-2">@showtime.Screen</span>
                                                            <span class="text-success fw-semibold mt-1">$@showtime.TicketPrice.ToString("F2") | @showtime.AvailableSeats seats left</span>
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="mb-4 col-md-4">
                                <label for="numberOfTickets" class="form-label fw-bold">Number of Tickets</label>
                                <input type="number" class="form-control" name="numberOfTickets" id="numberOfTickets" min="1" max="10" value="1" required />
                            </div>

                            <div class="d-grid mt-4 pt-3 border-top">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-check-circle me-1"></i> Confirm Booking & Pay
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning text-center py-4">
                                <i class="fas fa-exclamation-triangle fa-2x mb-3 text-warning"></i>
                                <h5>No Showtimes Available</h5>
                                <p class="mb-0">There are currently no active showtimes with available seats for this movie.</p>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
