@model IEnumerable<Movie_Booking_App.Models.Booking>
@{
    var user = ViewBag.UserInfo as Movie_Booking_App.Models.ApplicationUser;
    ViewData["Title"] = $"Bookings — {user?.FullName}";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="mb-4 text-start">
        <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="fas fa-arrow-left me-1"></i> Back to User List
        </a>
        <h2>🎟️ Booking History for @user?.FullName</h2>
        <p class="text-muted">Email: @user?.Email | Registered: @user?.CreatedAt.ToString("d")</p>
    </div>

    <!-- Stats summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white border-0 shadow-sm">
                <div class="card-body p-3">
                    <h6 class="text-white-50 text-uppercase mb-1">Total Bookings</h6>
                    <h3 class="mb-0">@ViewBag.TotalBookings</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white border-0 shadow-sm">
                <div class="card-body p-3">
                    <h6 class="text-white-50 text-uppercase mb-1">Total Tickets</h6>
                    <h3 class="mb-0">@ViewBag.TotalTickets</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white border-0 shadow-sm">
                <div class="card-body p-3">
                    <h6 class="text-white-50 text-uppercase mb-1">Total Spent</h6>
                    <h3 class="mb-0">$@ViewBag.TotalSpent.ToString("F2")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Bookings Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Booking #</th>
                            <th>Movie</th>
                            <th>Theater</th>
                            <th>Date Ordered</th>
                            <th>Showtime Date</th>
                            <th>Seats</th>
                            <th>Paid Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var booking in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@booking.BookingNumber</td>
                                    <td class="fw-semibold">@booking.ShowTime?.Movie?.Title</td>
                                    <td>@booking.ShowTime?.Theater?.Name (Screen: @booking.ShowTime?.Screen)</td>
                                    <td>@booking.BookingDate.ToString("g")</td>
                                    <td>@booking.ShowTime?.ShowDateTime.ToString("g")</td>
                                    <td>@booking.NumberOfTickets</td>
                                    <td class="fw-semibold text-success">$@booking.TotalAmount.ToString("F2")</td>
                                    <td>
                                        @if (booking.Status == Movie_Booking_App.Models.BookingStatus.Confirmed)
                                        {
                                            <span class="badge bg-success">Confirmed</span>
                                        }
                                        else if (booking.Status == Movie_Booking_App.Models.BookingStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No bookings found for this user.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
