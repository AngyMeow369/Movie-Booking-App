@model Movie_Booking_App.Models.Movie
@{
    ViewData["Title"] = "Delete Movie";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-exclamation-triangle me-1"></i> Delete Movie</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="lead">Are you sure you want to delete this movie?</p>
                    
                    <div class="border rounded p-3 mb-4 bg-light d-flex align-items-center">
                        <img src="@Model.PosterUrl" alt="@Model.Title" class="rounded me-3" style="width: 80px; height: 120px; object-fit: cover;" />
                        <div class="text-start">
                            <h5 class="fw-bold mb-1">@Model.Title</h5>
                            <p class="text-muted mb-1"><span class="badge bg-secondary">@Model.Genre</span></p>
                            <p class="text-muted mb-0"><strong>Duration:</strong> @Model.Duration mins</p>
                        </div>
                    </div>

                    <form asp-area="Admin" asp-controller="Movies" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center">
                            <a asp-area="Admin" asp-controller="Movies" asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt me-1"></i> Delete Movie
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
