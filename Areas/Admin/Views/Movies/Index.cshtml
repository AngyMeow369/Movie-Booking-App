@model IEnumerable<Movie_Booking_App.Models.Movie>
@{
    ViewData["Title"] = "Movies Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🎬 Movies Management</h2>
        <a asp-area="Admin" asp-controller="Movies" asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Add New Movie
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 80px;">Poster</th>
                            <th>Title</th>
                            <th>Genre</th>
                            <th>Language</th>
                            <th>Duration</th>
                            <th>Release Date</th>
                            <th>Status</th>
                            <th class="text-end" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@item.PosterUrl" alt="@item.Title" class="img-thumbnail" style="width: 50px; height: 75px; object-fit: cover;" />
                                </td>
                                <td class="fw-bold">@item.Title</td>
                                <td>@item.Genre</td>
                                <td>@item.Language</td>
                                <td>@(item.Duration) mins</td>
                                <td>@item.ReleaseDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="Movies" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a asp-area="Admin" asp-controller="Movies" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
