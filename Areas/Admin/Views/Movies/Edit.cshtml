@model Movie_Booking_App.Models.Movie
@{
    ViewData["Title"] = "Edit Movie";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold">🎬 Edit Movie — @Model.Title</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-area="Admin" asp-controller="Movies" asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Title" class="form-label fw-semibold">Movie Title</label>
                                <input asp-for="Title" class="form-control" placeholder="Enter movie title" required />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter movie description" required></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Genre" class="form-label fw-semibold">Genre</label>
                                <input asp-for="Genre" class="form-control" placeholder="e.g. Action, Comedy" required />
                                <span asp-validation-for="Genre" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Language" class="form-label fw-semibold">Language</label>
                                <input asp-for="Language" class="form-control" placeholder="e.g. English, Spanish" required />
                                <span asp-validation-for="Language" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Duration" class="form-label fw-semibold">Duration (in minutes)</label>
                                <input asp-for="Duration" type="number" class="form-control" placeholder="e.g. 120" required />
                                <span asp-validation-for="Duration" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ReleaseDate" class="form-label fw-semibold">Release Date</label>
                                <input asp-for="ReleaseDate" type="date" class="form-control" value="@Model.ReleaseDate.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="PosterUrl" class="form-label fw-semibold">Poster URL</label>
                                <input asp-for="PosterUrl" class="form-control" placeholder="https://example.com/poster.jpg" required />
                                <span asp-validation-for="PosterUrl" class="text-danger"></span>
                            </div>

                            <div class="col-md-12">
                                <div class="form-check form-switch py-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold">Mark Movie as Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                            <a asp-area="Admin" asp-controller="Movies" asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Update Movie
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
