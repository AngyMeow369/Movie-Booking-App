@model Movie_Booking_App.Models.ShowTime
@{
    ViewData["Title"] = "Create Showtime";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold">📅 Add Showtime</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-area="Admin" asp-controller="ShowTimes" asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MovieId" class="form-label fw-semibold">Movie</label>
                                <select asp-for="MovieId" class="form-select" asp-items="ViewBag.MovieId" required>
                                    <option value="">-- Select Movie --</option>
                                </select>
                                <span asp-validation-for="MovieId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TheaterId" class="form-label fw-semibold">Theater</label>
                                <select asp-for="TheaterId" class="form-select" asp-items="ViewBag.TheaterId" required>
                                    <option value="">-- Select Theater --</option>
                                </select>
                                <span asp-validation-for="TheaterId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ShowDateTime" class="form-label fw-semibold">Show Date & Time</label>
                                <input asp-for="ShowDateTime" class="form-control" type="datetime-local" required />
                                <span asp-validation-for="ShowDateTime" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TicketPrice" class="form-label fw-semibold">Ticket Price ($)</label>
                                <input asp-for="TicketPrice" class="form-control" type="number" step="0.01" min="0.01" required />
                                <span asp-validation-for="TicketPrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="TotalSeats" class="form-label fw-semibold">Total Seats</label>
                                <input asp-for="TotalSeats" class="form-control" type="number" min="1" max="500" required />
                                <span asp-validation-for="TotalSeats" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Screen" class="form-label fw-semibold">Screen</label>
                                <input asp-for="Screen" class="form-control" required />
                                <span asp-validation-for="Screen" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Format" class="form-label fw-semibold">Format</label>
                                <input asp-for="Format" class="form-control" required />
                                <span asp-validation-for="Format" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Language" class="form-label fw-semibold">Language</label>
                                <input asp-for="Language" class="form-control" required />
                                <span asp-validation-for="Language" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch pb-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold">Mark Showtime as Active</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                            <a asp-area="Admin" asp-controller="ShowTimes" asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-warning text-dark">
                                <i class="fas fa-save me-1"></i> Save Showtime
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
