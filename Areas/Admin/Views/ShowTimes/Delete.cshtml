@model Movie_Booking_App.Models.ShowTime
@{
    ViewData["Title"] = "Delete Showtime";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-exclamation-triangle me-1"></i> Delete Showtime</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <p class="lead">Are you sure you want to delete this showtime?</p>
                    
                    <div class="border rounded p-3 mb-4 bg-light text-start">
                        <h5 class="fw-bold mb-2">Movie: @Model.Movie?.Title</h5>
                        <p class="mb-1"><strong>Theater:</strong> @Model.Theater?.Name (Screen: @Model.Screen)</p>
                        <p class="mb-1"><strong>Date & Time:</strong> @Model.ShowDateTime.ToString("g")</p>
                        <p class="mb-0"><strong>Price:</strong> $@Model.TicketPrice.ToString("F2")</p>
                    </div>

                    <form asp-area="Admin" asp-controller="ShowTimes" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center">
                            <a asp-area="Admin" asp-controller="ShowTimes" asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt me-1"></i> Delete Showtime
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
