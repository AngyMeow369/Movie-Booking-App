@page "{id:int}"
@model Movie_Booking_App.Pages.Movies.DeleteModel
@{
    ViewData["Title"] = "Delete Movie";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3>Delete Movie</h3>
                </div>
                <div class="card-body">
                    <h4>Are you sure you want to delete this movie?</h4>
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> This action cannot be undone.
                    </div>
                    
                    <dl class="row">
                        <dt class="col-sm-3">Title:</dt>
                        <dd class="col-sm-9">@Model.Movie.Title</dd>
                        
                        <dt class="col-sm-3">Genre:</dt>
                        <dd class="col-sm-9">@Model.Movie.Genre</dd>
                        
                        <dt class="col-sm-3">Duration:</dt>
                        <dd class="col-sm-9">@Model.Movie.Duration minutes</dd>
                        
                        <dt class="col-sm-3">Language:</dt>
                        <dd class="col-sm-9">@Model.Movie.Language</dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="Movie.Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>