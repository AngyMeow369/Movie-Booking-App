@page
@model Movie_Booking_App.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center py-3">
                <h3><i class="bi bi-film"></i> MovieBook Login</h3>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" placeholder="Enter your email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Enter your password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label">Remember me</label>
                    </div>
                    
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Login</button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="mb-2">Don't have an account?</p>
                    <button class="btn btn-primary fw-bold"
                            id="RegisterButton"
                            data-url='@Url.Page("/Account/Register", null, new { handler = "Register" })'>
                        Register Here
                    </button>
                </div>

                    <div class="mt-3 p-3 bg-light rounded">
                        @* <h6>Test Admin Account:</h6>
                        <p class="mb-1"><strong>Email:</strong> admin@moviebook.com</p>
                        <p class="mb-0"><strong>Password:</strong> Admin123!</p> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
<script>
    document.getElementById('RegisterButton').addEventListener('click', function() {
        var url = this.getAttribute('data-url');
        // Navigate to the Razor Page OnGet handler
        window.location.href = url;
    });
</script>