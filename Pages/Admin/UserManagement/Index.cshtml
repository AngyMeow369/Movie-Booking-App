@page
@model Movie_Booking_App.Pages.Admin.UserManagement.IndexModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">User Management</h1>
            <p class="text-muted">Manage all registered users and view their booking history</p>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Total Users</div>
                            <div class="h5 mb-0">@Model.Users.Count</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Active Bookers</div>
                            <div class="h5 mb-0">@Model.Users.Count(u => u.TotalBookings > 0)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-ticket-alt fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Total Revenue</div>
                            <div class="h5 mb-0">₹@Model.Users.Sum(u => u.TotalSpent).ToString("N2")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-rupee-sign fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Avg. Spend</div>
                            <div class="h5 mb-0">₹@(Model.Users.Count > 0 ? (Model.Users.Sum(u => u.TotalSpent) / Model.Users.Count).ToString("N2") : "0.00")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-chart-line fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Users.Any())
    {
        <!-- Users Table -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-list text-primary me-2"></i>
                    All Registered Users
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">User Details</th>
                                <th>Contact</th>
                                <th>Registration</th>
                                <th>Booking Stats</th>
                                <th>Last Activity</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users.Where(u => u.FullName != "System Administrator"))
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle p-2 me-3">
                                                <i class="fas fa-user text-primary"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block">@user.FullName</strong>
                                                <small class="text-muted">ID: @user.Id.Substring(0, 8)...</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <div><i class="fas fa-envelope me-2 text-muted"></i>@user.Email</div>
                                            @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                            {
                                                <div><i class="fas fa-phone me-2 text-muted"></i>@user.PhoneNumber</div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="fas fa-calendar-plus me-1"></i>
                                            @user.CreatedAt.ToString("MMM dd, yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <span class="badge bg-primary me-2">
                                                <i class="fas fa-ticket-alt me-1"></i>@user.TotalBookings
                                            </span>
                                            <span class="badge bg-success">
                                                <i class="fas fa-rupee-sign me-1"></i>@user.TotalSpent.ToString("N2")
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (user.LastBookingDate.HasValue)
                                        {
                                            <small class="text-muted">
                                                <i class="fas fa-clock me-1"></i>
                                                @user.LastBookingDate.Value.ToString("MMM dd, yyyy")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No bookings</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-page="UserBookings" asp-route-userId="@user.Id" 
                                               class="btn btn-outline-primary btn-sm"
                                               title="View Bookings">
                                                <i class="fas fa-history"></i> Bookings
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="empty-state">
                    <i class="fas fa-users fa-4x text-muted mb-3"></i>
                    <h3 class="text-muted">No Users Found</h3>
                    <p class="text-muted mb-4">No users have registered yet.</p>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .table tbody tr {
        transition: background-color 0.2s ease;
    }
    
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    
    .empty-state {
        max-width: 400px;
        margin: 0 auto;
    }
    
    .bg-light {
        background-color: #f8f9fa !important;
    }
</style>