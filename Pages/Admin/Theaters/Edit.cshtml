@page "{id:int}"
@model Movie_Booking_App.Pages.Theaters.EditModel
@{
    ViewData["Title"] = "Edit Theater";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>Edit Theater</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Theater.Id" />
                        
                        <div class="mb-3">
                            <label asp-for="Theater.Name" class="form-label"></label>
                            <input asp-for="Theater.Name" class="form-control" />
                            <span asp-validation-for="Theater.Name" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Theater.Location" class="form-label"></label>
                            <input asp-for="Theater.Location" class="form-control" />
                            <span asp-validation-for="Theater.Location" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Theater.City" class="form-label"></label>
                            <input asp-for="Theater.City" class="form-control" />
                            <span asp-validation-for="Theater.City" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="Theater.IsActive" class="form-check-input" />
                            <label asp-for="Theater.IsActive" class="form-check-label">Active (available for bookings)</label>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Update Theater</button>
                            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}