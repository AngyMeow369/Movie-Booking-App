@page
@model Movie_Booking_App.Pages.Admin.Movies.IndexModel
@{
    ViewData["Title"] = "Movies";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-warning"><i class="bi bi-film me-2"></i> Movies</h1>
        <a asp-page="Create" class="btn btn-primary">🎬 Add New Movie</a>
    </div>

    @if (Model.Movies.Any())
    {
        <div class="row">
            @foreach (var movie in Model.Movies)
            {
                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card h-100 movie-card shadow-sm border-0 bg-dark text-white">
                        @if (!string.IsNullOrEmpty(movie.PosterUrl))
                        {
                            <div class="poster-container">
                                <img src="@movie.PosterUrl" class="card-img-top poster-img" alt="@movie.Title">
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-warning">@movie.Title</h5>
                            <p class="card-text small text-light">
                                <strong>Genre:</strong> @movie.Genre<br>
                                <strong>Duration:</strong> @movie.Duration minutes<br>
                                <strong>Language:</strong> @movie.Language<br>
                                <strong>Release:</strong> @movie.ReleaseDate.ToString("MMM dd, yyyy")
                            </p>
                            <p class="card-text text-muted small">
                                @(movie.Description.Length > 100 ? movie.Description.Substring(0, 100) + "..." : movie.Description)
                            </p>
                            <span class="badge @(movie.IsActive ? "bg-success" : "bg-secondary")">
                                @(movie.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                        <div class="card-footer bg-transparent border-0">
                            <div class="d-flex gap-2">
                                <a asp-page="Edit" asp-route-id="@movie.Id" class="btn btn-warning btn-sm">✏️ Edit</a>
                                <a asp-page="Delete" asp-route-id="@movie.Id" class="btn btn-danger btn-sm">🗑️ Delete</a>
                                <a asp-page="/ShowTimes/Create" asp-route-movieId="@movie.Id" class="btn btn-info btn-sm">⏰ Add Show</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No Movies Found</h4>
            <p>There are no movies in the database yet. <a asp-page="Create">Add the first movie</a>.</p>
        </div>
    }
</div>

<style>
    body {
        background-color: #0b0c10;
        color: #f1f1f1;
    }

    .movie-card {
        transition: transform 0.2s, box-shadow 0.2s;
        border-radius: 0.5rem;
    }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

    .poster-container {
        overflow: hidden;
        border-top-left-radius: 0.5rem;
        border-top-right-radius: 0.5rem;
    }

    .poster-img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 0.5rem 0.5rem 0 0;
    }

    .btn-sm {
        font-size: 0.85rem;
        padding: 0.3rem 0.5rem;
    }

    h1 i {
        color: #ffc107;
    }
</style>
