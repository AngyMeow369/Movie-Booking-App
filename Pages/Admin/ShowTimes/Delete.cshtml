@page "{id:int}"
@model Movie_Booking_App.Pages.Admin.ShowTimes.DeleteModel
@{
    ViewData["Title"] = "Delete Show Time";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3>Delete Show Time</h3>
                </div>
                <div class="card-body">
                    <h4>Are you sure you want to delete this show time?</h4>
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> This will also delete any associated bookings.
                    </div>
                    
                    <dl class="row">
                        <!-- ✅ FIXED: Added null-conditional operators -->
                        <dt class="col-sm-3">Movie:</dt>
                        <dd class="col-sm-9">@Model.ShowTime.Movie?.Title</dd>
                        
                        <dt class="col-sm-3">Theater:</dt>
                        <dd class="col-sm-9">@Model.ShowTime.Theater?.Name - @Model.ShowTime.Theater?.City</dd>
                        
                        <dt class="col-sm-3">Date & Time:</dt>
                        <dd class="col-sm-9">@Model.ShowTime.ShowDateTime.ToString("MMM dd, yyyy hh:mm tt")</dd>
                        
                        <dt class="col-sm-3">Screen:</dt>
                        <dd class="col-sm-9">@Model.ShowTime.Screen</dd>
                        
                        <dt class="col-sm-3">Price:</dt>
                        <dd class="col-sm-9">$@Model.ShowTime.TicketPrice</dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="ShowTime.Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>