@page
@model Movie_Booking_App.Pages.User.IndexModel
@using Microsoft.AspNetCore.Authorization
@using Movie_Booking_App.Models

@attribute [Authorize]

@{
    ViewData["Title"] = "User Dashboard";
}

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4">
    <div class="container-fluid">
        <h4 class="navbar-brand text-primary mb-0">🎬 User Dashboard</h4>
        <div class="d-flex align-items-center">
            <span class="fw-semibold">Welcome, @Model.FullName!</span>
        </div>
    </div>
</nav>

<div class="container">
    <div class="row g-4">

        <!-- Profile Section -->
        @* <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-person-circle me-2"></i> Profile
                </div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.FullName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                </div>
            </div>
        </div> *@

        @* <!-- My Bookings Section -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-ticket-perforated-fill me-2"></i> My Bookings
                </div>
                <div class="card-body">
                    @if (Model.Bookings.Any())
                    {
                        <div class="row g-3">
                            @foreach (var booking in Model.Bookings)
                            {
                                <div class="col-12">
                                    <div class="card booking-card shadow-sm">
                                        <div class="row g-0">
                                            <div class="col-4">
                                                <img src="@booking.ShowTime.Movie!.PosterUrl"
                                                     class="img-fluid rounded-start"
                                                     alt="@booking.ShowTime.Movie!.Title">
                                            </div>
                                            <div class="col-8">
                                                <div class="card-body d-flex flex-column justify-content-between h-100">
                                                    <div>
                                                        <h5 class="card-title">@booking.ShowTime.Movie!.Title</h5>
                                                        <p class="mb-1"><strong>Genre:</strong> @booking.ShowTime.Movie!.Genre</p>
                                                        <p class="mb-1"><strong>Theatre:</strong> @booking.ShowTime.Theater!.Name, @booking.ShowTime.Screen</p>
                                                        <p class="mb-1"><strong>Date & Time:</strong> @booking.ShowTime.ShowDateTime.ToString("dd MMM yyyy, hh:mm tt")</p>
                                                        <p class="mb-1"><strong>Tickets:</strong> @booking.NumberOfTickets</p>
                                                        <p class="mb-1"><strong>Total:</strong> @booking.TotalAmount.ToString("C")</p>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                                        @if (booking.Status == BookingStatus.Confirmed)
                                                        {
                                                            <span class="badge rounded-pill bg-success py-1 px-2">Confirmed</span>
                                                            <form method="post" asp-page-handler="CancelBooking" class="mb-0">
                                                                <input type="hidden" name="bookingId" value="@booking.Id" />
                                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                                        onclick="return confirm('Are you sure you want to cancel this booking?');">
                                                                    Cancel
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge rounded-pill bg-secondary py-1 px-2">Cancelled</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">You have no bookings yet.</p>
                    }
                </div>
            </div>
        </div> *@

        <!-- My Bookings CTA -->
        <a asp-page="/User/UserBookings/UserBookings" class="text-decoration-none">
            <div class="card text-white bg-primary shadow-sm hover-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title mb-0"><i class="bi bi-ticket-perforated-fill me-2"></i> My Bookings</h5>
                        <p class="card-text mb-0">View all your booked movies and manage them.</p>
                    </div>
                    <div>
                        <i class="bi bi-arrow-right-circle fs-2"></i>
                    </div>
                </div>
            </div>
        </a>



        <!-- Available Movies Section -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-film me-2"></i> Available Movies
                </div>
                <div class="card-body">
                    @if (Model.AvailableMovies.Any())
                    {
                        <div class="row g-3">
                            @foreach (var movie in Model.AvailableMovies)
                            {
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 shadow-sm">
                                        <img src="@movie.PosterUrl" class="card-img-top poster-img" alt="@movie.Title">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">@movie.Title</h5>
                                            <p class="card-text mb-1"><strong>Genre:</strong> @movie.Genre</p>
                                            @{
                                                int hours = movie.Duration / 60;
                                                int minutes = movie.Duration % 60;
                                            }
                                            <p class="card-text mb-2"><strong>Length:</strong> @hours h @minutes m</p>
                                            <a asp-page="/User/BookMovie/BookMovie" asp-route-id="@movie.Id" class="btn btn-primary mt-auto">Book Now</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No movies available for booking at the moment.</p>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .poster-img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 0.25rem 0.25rem 0 0;
    }

    .booking-card img {
        height: 100%;
        object-fit: cover;
        border-radius: 0.25rem 0 0 0.25rem;
    }

    .booking-card .card-body {
        padding: 0.75rem 1rem;
    }

    .booking-card .badge {
        font-size: 0.85rem;
        padding: 0.35em 0.65em;
    }

    .btn-outline-danger {
        font-size: 0.8rem;
        padding: 0.25rem 0.5rem;
    }

    .card-title {
        font-size: 1.05rem;
        font-weight: 600;
    }

    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }


    media (max-width: 576px) {
        .booking-card {
            flex-direction: column;
        }

        .booking-card img {
            border-radius: 0.25rem 0.25rem 0 0;
        }
    }
</style>
