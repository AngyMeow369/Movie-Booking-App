@page
@model Movie_Booking_App.Pages.User.IndexModel
@using Microsoft.AspNetCore.Authorization
@using Movie_Booking_App.Models

@attribute [Authorize]

@{
    ViewData["Title"] = "User Dashboard";
}

<!-- Navbar with Logout Button -->
<nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
    <div class="container-fluid">
        <h4 class="navbar-brand text-primary mb-0">🎬 User Dashboard</h4>

        <div class="d-flex align-items-center">
            <span class="me-3 fw-semibold">Welcome, @Model.FullName!</span>

            @* <form method="post" asp-page-handler="Logout" class="mb-0">
                <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
            </form> *@
        </div>
    </div>
</nav>

<div class="container mt-4">
    <div class="row">
        <!-- Profile Section -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">Profile</div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.FullName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    @* <a asp-page="/Account/EditProfile" class="btn btn-sm btn-outline-primary">Edit Profile</a> *@
                </div>
            </div>
        </div>

        <!-- Booking Section -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">My Bookings</div>
                <div class="card-body">
                    @if (Model.Bookings.Any())
                    {
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Movie</th>
                                    <th>Date</th>
                                    <th>Seats</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in Model.Bookings)
                                {
                                    <tr>
                                        <td>@booking.ShowTime.Movie.Title</td>
                                        <td>@booking.ShowTime.ShowDateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td>@booking.NumberOfTickets</td>
                                        <td>@booking.TotalAmount.ToString("C")</td>
                                        <td>
                                            @if (booking.Status == BookingStatus.Confirmed)
                                            {
                                                <span class="badge bg-success">Confirmed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Cancelled</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No bookings found.</p>
                    }
                </div>
            </div>
        </div>
        <!-- Available Movies Section -->
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-info text-white">Available Movies</div>
            <div class="card-body">
                @if (Model.AvailableMovies.Any())
                {
                    <div class="row">
                        @foreach (var movie in Model.AvailableMovies)
                        {
                            <div class="col-md-3 mb-3">
                                <div class="card h-100">
                                    <img src="@movie.PosterUrl" class="card-img-top poster-img" alt="@movie.Title">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">@movie.Title</h5>
                                        <p class="card-text">Genre:@movie.Genre</p>
                                        @{
                                            int hours = movie.Duration / 60;
                                            int minutes = movie.Duration % 60;
                                        }
                                        <p class="card-text">Length: @hours h @minutes m</p>
                                        <a asp-page="/User/BookMovie" asp-route-id="@movie.Id" class="btn btn-sm btn-primary mt-auto">Book Now</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>No movies available for booking at the moment.</p>
                }
            </div>
        </div>

    </div>
</div>


<style>
    .poster-img {
        width: 100%; /* full width of card */
        aspect-ratio: 2 / 3; /* 2:3 poster ratio */
        object-fit: cover; /* fill box without stretching */
        border-radius: 4px 4px 0 0; /* match card top corners */
    }

</style>