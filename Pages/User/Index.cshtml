@page
@model Movie_Booking_App.Pages.User.IndexModel
@using Microsoft.AspNetCore.Authorization
@using Movie_Booking_App.Models

@attribute [Authorize]

@{
    ViewData["Title"] = "User Dashboard";
}

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm mb-4">
    <div class="container-fluid">
        <h4 class="navbar-brand text-primary mb-0">🎬 User Dashboard</h4>
        <div class="d-flex align-items-center">
            <span class="fw-semibold">Welcome, @Model.FullName!</span>
        </div>
    </div>
</nav>

<div class="container">

    <!-- My Bookings CTA -->
    <div class="row justify-content-center mb-4">
        <div class="col-md-5 col-sm-8">
            <a asp-page="/User/UserBookings/UserBookings" class="text-decoration-none">
                <div class="card shadow-sm hover-card bookings-card text-white text-center p-3">
                    <h5 class="card-title mb-2"><i class="bi bi-ticket-perforated-fill me-2"></i> My Bookings</h5>
                    <p class="card-text mb-0">View and manage your movie bookings.</p>
                </div>
            </a>
        </div>
    </div>

    <!-- Available Movies Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-film me-2"></i> Available Movies
                </div>
                <div class="card-body">
                    @if (Model.AvailableMovies.Any())
                    {
                        <div class="row g-3">
                            @foreach (var movie in Model.AvailableMovies)
                            {
                                <div class="col-md-3 col-sm-6">
                                    <div class="card h-100 movie-card shadow-sm">
                                        <div class="poster-container">
                                            <img src="@movie.PosterUrl" class="card-img-top poster-img" alt="@movie.Title">
                                        </div>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title movie-title">
                                                <a asp-page="/User/MovieDetails/MovieDetails" asp-route-id="@movie.Id" class="text-warning text-decoration-none">
                                                    @movie.Title
                                                </a>
                                            </h5>

                                            <p class="card-text movie-details mb-1"><strong>Genre:</strong> @movie.Genre</p>
                                            @{
                                                int hours = movie.Duration / 60;
                                                int minutes = movie.Duration % 60;
                                            }
                                            <p class="card-text movie-details mb-2"><strong>Length:</strong> @hours h @minutes m</p>
                                            <a asp-page="/User/BookMovie/BookMovie" asp-route-id="@movie.Id" class="btn btn-primary mt-auto">Book Now</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No movies available for booking at the moment.</p>
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    /* Poster Hover */
    .poster-container {
        overflow: hidden;
        border-radius: 0.25rem 0.25rem 0 0;
    }

    .poster-img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .poster-container:hover .poster-img {
        transform: scale(1.05);
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }

    /* Movie card hover */
    .movie-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .movie-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

    /* Movie title & details */
    .movie-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.3rem;
        color: #FFD700;
    }

    .movie-details {
        font-size: 0.9rem;
        color: #555;
    }

    /* My Bookings Card */
    .bookings-card {
        background: linear-gradient(135deg, #1f3b70, #3a64b2);
        border-radius: 0.75rem;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .bookings-card:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
        }

    .hover-card {
        cursor: pointer;
    }

    .card-title i {
        vertical-align: middle;
    }

    /* Responsive fixes */
    media (max-width: 576px) {
        .bookings-card

    {
        padding: 1rem;
    }

    }
</style>
