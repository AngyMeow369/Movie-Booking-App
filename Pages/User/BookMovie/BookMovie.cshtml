@page
@model Movie_Booking_App.Pages.User.BookMovie.BookMovieModel
@{
    ViewData["Title"] = "Book Movie";
    Layout = "_UserLayout";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">Book Tickets for @Model.Movie.Title</h2>

    <form method="post" class="shadow-sm p-4 rounded bg-white">
        <input type="hidden" asp-for="MovieId" />

        @if (Model.GroupedShowTimes.Any())
        {
            @foreach (var group in Model.GroupedShowTimes)
            {
                var theatre = group.Key;
                <div class="theatre-section mb-4 border rounded p-3">
                    <h5 class="text-success">
                        🎭 @theatre.Name
                    </h5>
                    <p class="text-muted mb-2">
                        Location: @theatre.Location<br />
                        Screens: @group.Value.Count | Format: @group.Value.First().Format
                    </p>

                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Show Time</th>
                                <th>Screen</th>
                                <th>Language</th>
                                <th>Format</th>
                                <th>Available Seats</th>
                                <th>Price (₹)</th>
                                <th>Select</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var show in group.Value)
                            {
                                <tr>
                                    <td>@show.ShowDateTime.ToString("dd MMM yyyy hh:mm tt")</td>
                                    <td>@show.Screen</td>
                                    <td>@show.Language</td>
                                    <td>@show.Format</td>
                                    <td>@show.AvailableSeats</td>
                                    <td>@show.TicketPrice</td>
                                    <td>
                                        <input type="radio" asp-for="SelectedShowTimeId" value="@show.Id" required />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-semibold">Number of Tickets</label>
                <input asp-for="NumberOfTickets" type="number" min="1" class="form-control" />
            </div>

            <button type="button" class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#confirmModal">
                Confirm Booking
            </button>

            <!-- Confirmation Modal -->
            <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="confirmModalLabel">Confirm Your Booking</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p><strong>Movie:</strong> @Model.Movie.Title</p>
                            <p><strong>Showtime:</strong> <span id="modalShowtime">-</span></p>
                            <p><strong>Theatre:</strong> <span id="modalTheatre">-</span></p>
                            <p><strong>Tickets:</strong> <span id="modalTickets">@Model.NumberOfTickets</span></p>
                            <p><strong>Total Price:</strong> ₹<span id="modalPrice">0</span></p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Finalize Booking</button>
                        </div>
                    </div>
                </div>
            </div>

        }
        else
        {
            <div class="alert alert-info">No active showtimes available for this movie.</div>
        }
    </form>
</div>

<script>
    const showtimeRadios = document.querySelectorAll('input[name="SelectedShowTimeId"]');
    const numberTicketsInput = document.querySelector('input[name="NumberOfTickets"]');

    const modalShowtime = document.getElementById('modalShowtime');
    const modalTheatre = document.getElementById('modalTheatre');
    const modalTickets = document.getElementById('modalTickets');
    const modalPrice = document.getElementById('modalPrice');

    showtimeRadios.forEach(radio => {
        radio.addEventListener('change', () => {
            const row = radio.closest('tr');
            modalShowtime.textContent = row.cells[0].innerText;
            modalTheatre.textContent = row.closest('.theatre-section').querySelector('h5').innerText;
            modalTickets.textContent = numberTicketsInput.value;
            modalPrice.textContent = (parseInt(numberTicketsInput.value) * parseFloat(row.cells[5].innerText)).toFixed(2);
        });
    });

    numberTicketsInput.addEventListener('input', () => {
        const selectedRadio = document.querySelector('input[name="SelectedShowTimeId"]:checked');
        if (selectedRadio) {
            selectedRadio.dispatchEvent(new Event('change'));
        }
    });
</script>

<style>
    .theatre-section {
        background-color: #f8f9fa;
    }

    h5.text-success {
        font-weight: 600;
    }

    table {
        font-size: 0.95rem;
    }
</style>
