@page
@model Movie_Booking_App.Pages.User.BookMovieModel
@{
    ViewData["Title"] = "Book Movie";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">Book Tickets for @Model.Movie.Title</h2>

    <form method="post" class="shadow-sm p-4 rounded bg-white">
        <input type="hidden" asp-for="MovieId" />

        @if (Model.GroupedShowTimes.Any())
        {
            @foreach (var group in Model.GroupedShowTimes)
            {
                var theatre = group.Key;
                <div class="theatre-section mb-4 border rounded p-3">
                    <h5 class="text-success">
                        🎭 @theatre.Name
                    </h5>
                    <p class="text-muted mb-2">
                        Location: @theatre.Location<br />
                        Screens: @group.Value.Count | Format: @group.Value.First().Format
                    </p>

                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Show Time</th>
                                <th>Screen</th>
                                <th>Language</th>
                                <th>Format</th>
                                <th>Available Seats</th>
                                <th>Price (₹)</th>
                                <th>Select</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var show in group.Value)
                            {
                                <tr>
                                    <td>@show.ShowDateTime.ToString("dd MMM yyyy hh:mm tt")</td>
                                    <td>@show.Screen</td>
                                    <td>@show.Language</td>
                                    <td>@show.Format</td>
                                    <td>@show.AvailableSeats</td>
                                    <td>@show.TicketPrice</td>
                                    <td>
                                        <input type="radio" asp-for="SelectedShowTimeId" value="@show.Id" required />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-semibold">Number of Tickets</label>
                <input asp-for="NumberOfTickets" type="number" min="1" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success w-100">Confirm Booking</button>
        }
        else
        {
            <div class="alert alert-info">No active showtimes available for this movie.</div>
        }
    </form>
</div>

<style>
    .theatre-section {
        background-color: #f8f9fa;
    }

    h5.text-success {
        font-weight: 600;
    }

    table {
        font-size: 0.95rem;
    }
</style>
