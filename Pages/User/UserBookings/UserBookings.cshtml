@page
@model Movie_Booking_App.Pages.User.UserBookings.UserBookingsModel
@using Microsoft.AspNetCore.Authorization
@using Movie_Booking_App.Models

@{
    Layout = "_UserLayout";
}

@attribute [Authorize]

<div class="container mt-4">
    <h3 class="mb-4"><i class="bi bi-ticket-perforated-fill me-2"></i> My Bookings</h3>

    @if (Model.Bookings.Any())
    {
        <div class="row g-3">
            @foreach (var booking in Model.Bookings)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card shadow-sm h-100 booking-card">
                        <img src="@booking.ShowTime.Movie!.PosterUrl" class="card-img-top poster-img" alt="@booking.ShowTime.Movie!.Title">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@booking.ShowTime.Movie!.Title</h5>
                            <p class="card-text mb-1"><strong>Theatre:</strong> @booking.ShowTime.Theater!.Name</p>
                            <p class="card-text mb-1"><strong>Date & Time:</strong> @booking.ShowTime.ShowDateTime.ToString("dd MMM yyyy, hh:mm tt")</p>
                            <p class="card-text mb-1"><strong>Seats:</strong> @booking.NumberOfTickets</p>
                            <p class="card-text mb-2"><strong>Total:</strong> @booking.TotalAmount.ToString("C")</p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                @if (booking.Status == BookingStatus.Confirmed)
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                    <form method="post" asp-page-handler="CancelBooking" class="d-inline">
                                        <input type="hidden" name="bookingId" value="@booking.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to cancel this booking?');">
                                            Cancel
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">You have no bookings yet.</p>
    }
</div>

<style>
    .poster-img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 0.25rem 0.25rem 0 0;
    }

    .booking-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .booking-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }
</style>
