<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieBook</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Movie_Booking_App.styles.css" asp-append-version="true" />
    <style>
        .navbar-brand {
            font-weight: bold;
            font-size: 1.8rem;
            color: #ffd700 !important;
        }
        
        .bg-cinema {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        }
        
        .nav-link {
            font-weight: 500;
            transition: color 0.3s ease;
        }
        
        .nav-link:hover {
            color: #ffd700 !important;
        }
        
        .btn-logout {
            color: #ff6b6b !important;
            border: none;
            background: none;
            padding: 0.375rem 0.75rem;
        }
        
        .btn-logout:hover {
            color: #ff5252 !important;
            background: rgba(255, 107, 107, 0.1);
        }
        
        .user-welcome {
            color: #ffd700 !important;
            font-weight: 600;
        }
        
        .admin-badge {
            background: #28a745;
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            margin-left: 0.5rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-cinema border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="Admin/Index">
                    🎬 MovieBook
                </a>
                
                @if (User.Identity.IsAuthenticated)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <!-- Navigation for Logged-in Users -->
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Movies/Index">🎭 Movies</a>
                            </li>
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <!-- Admin Only Navigation -->
                                <li class="nav-item">
                                    <a class="nav-link text-warning" asp-page="/Admin/Index">⚡ Admin Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-page="/Theaters/Index">🏢 Theaters</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-page="/Admin/Users">👥 Users</a>
                                </li>
                            }
                            else
                            {
                                <!-- Regular User Navigation -->
                                <li class="nav-item">
                                    <a class="nav-link text-white" href="#">📚 My Bookings</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" href="#">⭐ Favorites</a>
                                </li>
                            }
                        </ul>
                        
                        <!-- User Info & Logout -->
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-welcome" href="#" role="button" data-bs-toggle="dropdown">
                                    👋 @User.Identity.Name
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="admin-badge">ADMIN</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end p-2">
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center" asp-page="/Account/EditProfile">
                                            👤 Edit Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center" href="#">
                                            ⚙️ Settings
                                        </a>
                                    </li>
                                    <li class="my-2">
                                        <form method="post" asp-page-handler="Logout" class="mb-0">
                                            <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                                                🚪 Logout
                                            </button>
                                        </form>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                </ul>
                            </li>
                        </ul>

                    </div>
                }
                else
                {
                    <!-- Navigation for Guests (Not Logged In) -->
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Movies/Index">🎭 Browse Movies</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Account/Login">🔐 Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Account/Register">📝 Register</a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    &copy; 2025 - MovieBook - Your Ultimate Movie Experience
                </div>
                <div class="col-md-6 text-end">
                    <a asp-page="/Privacy" class="text-muted">Privacy Policy</a> 
                    <span class="mx-2">|</span>
                    <a href="#" class="text-muted">Contact Us</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>