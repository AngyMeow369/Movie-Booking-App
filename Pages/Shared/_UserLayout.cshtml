<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieBook User</title>

    <!-- Font-Awesome + Bootstrap -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Movie_Booking_App.styles.css" asp-append-version="true" />

    <style>
        :root {
            --user-primary: #ff6b6b;
            --user-secondary: #1a1a2e;
        }
        .navbar-brand {
            font-weight: bold;
            font-size: 1.8rem;
            color: var(--user-primary) !important;
        }
        .bg-user {
            background: linear-gradient(135deg, var(--user-secondary) 0%, #16213e 50%, #0f3460 100%);
        }
        .nav-link {
            font-weight: 500;
            transition: color .3s ease;
        }
        .nav-link:hover {
            color: var(--user-primary) !important;
        }
        .btn-logout {
            color: #ff6b6b !important;
            border: none;
            background: none;
            padding: .375rem .75rem;
        }
        .btn-logout:hover {
            color: #ff5252 !important;
            background: rgba(255, 107, 107, .1);
        }
        .user-welcome {
            color: var(--user-primary) !important;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-user">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/User/Index">
                    <i class="fas fa-film me-2"></i>MovieBook
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#userNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="userNavbar">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/User/Index">
                                <i class="fas fa-home me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/User/Index">
                                <i class="fas fa-film me-1"></i>Movies
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/User/UserBookings/UserBookings">
                                <i class="fas fa-ticket-alt me-1"></i>My Bookings
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-welcome" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end p-2">
                                <li>
                                    <a class="dropdown-item" asp-page="/Account/EditProfile">
                                        <i class="fas fa-user-edit me-1"></i>Edit Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="fas fa-cog me-1"></i>Settings
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-page="/Account/Login" asp-page-handler="Logout" class="px-2">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="fas fa-sign-out-alt me-1"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MovieBook - User Panel
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>