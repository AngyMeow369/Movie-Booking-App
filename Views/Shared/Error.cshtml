@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <i class="fas fa-exclamation-triangle fa-4x text-danger mb-4"></i>
                    <h1 class="display-4 fw-bold text-danger">Oops!</h1>
                    <h4 class="text-muted mb-4">Something went wrong.</h4>
                    <p class="text-muted">An unexpected error occurred. Please try again later.</p>
                    <a href="/" class="btn btn-primary mt-3">
                        <i class="fas fa-home me-1"></i> Go Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
